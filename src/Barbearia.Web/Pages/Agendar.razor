@page "/agendar"
@using Barbearia.Web.Models
@inject HttpClient Http

<PageTitle>Agendar Horário</PageTitle>

<h1>Agendar um horário 💈</h1>

<div>
    <label>Barbeiro:</label>
    <select @bind="barbeiroIdSelecionado">
        <option value="0">Selecione um barbeiro...</option>
        @foreach (var barbeiro in barbeiros)
        {
            <option value="@barbeiro.Id">@barbeiro.Nome</option>
        }
    </select>
</div>

<div>
    <label>Cliente:</label>
    <select @bind="clienteIdSelecionado">
        <option value="0">Selecione um cliente...</option>
        @foreach (var cliente in clientes)
        {
            <option value="@cliente.Id">@cliente.Nome</option>
        }
    </select>
</div>

<div>
    <label>Data:</label>
    <input type="date" @bind="dataSelecionada" min="@hoje.ToString("yyyy-MM-dd")" />
</div>

<button @onclick="BuscarHorariosAsync">Buscar horários disponíveis</button>

@if (horariosDisponiveis.Any())
{
    <h3>Horários disponíveis:</h3>
    <div>
        @foreach (var horario in horariosDisponiveis)
        {
            <button @onclick="() => MarcarAsync(horario)">@horario.ToString("HH:mm")</button>
        }
    </div>
}

@if (mensagem is not null)
{
    <p><strong>@mensagem</strong></p>
}

<h3>Agendamentos confirmados</h3>
<table>
    <thead>
        <tr>
            <th>Cliente</th>
            <th>Barbeiro</th>
            <th>Data</th>
            <th>Hora</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var agendamento in agendamentosExistentes)
        {
            <tr>
                <td>@agendamento.Cliente.Nome</td>
                <td>@agendamento.Barbeiro.Nome</td>
                <td>@agendamento.Data.ToString("dd/MM/yyyy")</td>
                <td>@agendamento.Hora.ToString("HH:mm")</td>
                <td><button @onclick="() => CancelarAsync(agendamento.Id)">Cancelar</button></td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<BarbeiroDto> barbeiros = new();
    private List<ClienteDto> clientes = new();
    private List<TimeOnly> horariosDisponiveis = new();
    private List<AgendamentoDto> agendamentosExistentes = new();

    private readonly DateOnly hoje = DateOnly.FromDateTime(DateTime.Today);

    private int barbeiroIdSelecionado;
    private int clienteIdSelecionado;
    private DateOnly dataSelecionada = DateOnly.FromDateTime(DateTime.Today);
    private string? mensagem;

    protected override async Task OnInitializedAsync()
    {
        barbeiros = await Http.GetFromJsonAsync<List<BarbeiroDto>>("barbeiros") ?? new();
        clientes = await Http.GetFromJsonAsync<List<ClienteDto>>("clientes") ?? new();
        await CarregarAgendamentosAsync();
    }

    private async Task CarregarAgendamentosAsync()
    {
        agendamentosExistentes = await Http.GetFromJsonAsync<List<AgendamentoDto>>("agendamentos") ?? new();
    }

    private async Task CancelarAsync(int agendamentoId)
    {
        var resposta = await Http.PostAsync($"agendamentos/{agendamentoId}/cancelar", null);

        if (resposta.IsSuccessStatusCode)
        {
            mensagem = "Agendamento cancelado.";
            await CarregarAgendamentosAsync();
            await BuscarHorariosAsync();
        }
        else
        {
            mensagem = "Não foi possível cancelar o agendamento.";
        }
    }

    private async Task BuscarHorariosAsync()
    {
        var url = $"agendamentos/horarios-disponiveis?barbeiroId={barbeiroIdSelecionado}&data={dataSelecionada:yyyy-MM-dd}";
        horariosDisponiveis = await Http.GetFromJsonAsync<List<TimeOnly>>(url) ?? new();
        mensagem = null;
    }

    private async Task MarcarAsync(TimeOnly hora)
    {
        if (clienteIdSelecionado == 0)
        {
            mensagem = "Selecione um cliente antes de marcar.";
            return;
        }

        var pedido = new
        {
            ClienteId = clienteIdSelecionado,
            BarbeiroId = barbeiroIdSelecionado,
            Data = dataSelecionada,
            Hora = hora
        };

        var resposta = await Http.PostAsJsonAsync("agendamentos/", pedido);

        if (resposta.IsSuccessStatusCode)
        {
            mensagem = "Agendamento criado com sucesso!";
            await BuscarHorariosAsync();
            await CarregarAgendamentosAsync();
        }
        else
        {
            var erro = await resposta.Content.ReadFromJsonAsync<ErroDto>();
            mensagem = erro?.Mensagem ?? "Não foi possível criar o agendamento.";
        }
    }
}
